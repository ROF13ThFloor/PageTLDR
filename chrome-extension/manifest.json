{
  "manifest_version": 3,
  "name": "Reading Lens",
  "version": "0.1.0",
  "description": "An AI reading helper: summary, key points, hard words, and questions for any web page.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Reading Lens"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": ["sidePanel", "storage", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"]
}
